{
  "openapi": "3.1.0",
  "info": {
    "title": "Gatehouse read-only management API",
    "version": "1.0.0",
    "description": "Backend bearer-token integration. Disabled when MANAGEMENT_API_TOKEN is empty. Poll /api/v1/dashboard every 20 seconds by default. GET and HEAD only; no pagination or filters, query parameters are ignored. Paths are exact (no trailing slash). Browser sessions and CORS are not used. Collection errors are cached for the configured TTL and reported explicitly."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "managementBearer": []
    }
  ],
  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Fetch all realm dashboard data in one snapshot",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Dashboard"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "operationId": "headDashboard",
        "summary": "Headers for dashboard",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DashboardHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Fetch realm reachability and population counts",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Status"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headStatus",
        "summary": "Headers for status",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/StatusHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/players": {
      "get": {
        "operationId": "getPlayers",
        "summary": "List online human characters, including GMs",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Players"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headPlayers",
        "summary": "Headers for players",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/PlayersHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/leaderboards": {
      "get": {
        "operationId": "getLeaderboards",
        "summary": "Fetch all five leaderboards",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Leaderboards"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headLeaderboards",
        "summary": "Headers for leaderboards",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/LeaderboardsHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/modules": {
      "get": {
        "operationId": "getModules",
        "summary": "List detected module IDs and titles",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Modules"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headModules",
        "summary": "Headers for modules",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ModulesHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "managementBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated MANAGEMENT_API_TOKEN, minimum 32 printable ASCII characters without spaces. Send in Authorization only. No cookies or query-string credentials."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "not_found",
              "method_not_allowed",
              "internal_error",
              "status_unavailable",
              "players_unavailable",
              "leaderboards_unavailable",
              "modules_unavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "CollectionError": {
        "type": "object",
        "required": [
          "section",
          "code",
          "message"
        ],
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "status",
              "players",
              "leaderboards",
              "modules"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "status_unavailable",
              "players_unavailable",
              "leaderboards_unavailable",
              "modules_unavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Population": {
        "type": "object",
        "required": [
          "humans",
          "bots",
          "gms",
          "total",
          "alliance",
          "horde"
        ],
        "properties": {
          "humans": {
            "type": "integer",
            "minimum": 0
          },
          "bots": {
            "type": "integer",
            "minimum": 0
          },
          "gms": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "alliance": {
            "type": "integer",
            "minimum": 0
          },
          "horde": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "Online character counts. Humans include GMs; gms is a subset. Total is humans plus bots. Faction counts cover humans. Aggregate counts do not apply the Auctioneer roster exclusion."
      },
      "Status": {
        "type": "object",
        "required": [
          "realm_name",
          "realm_up",
          "core_name",
          "expansion",
          "world_version",
          "public_host",
          "public_auth_port",
          "public_world_port",
          "population"
        ],
        "properties": {
          "realm_name": {
            "type": "string"
          },
          "realm_up": {
            "type": "boolean",
            "description": "Successful read-only SOAP server info probe or TCP worldserver connection. False is valid realm-down data, not a collection error."
          },
          "core_name": {
            "type": "string"
          },
          "expansion": {
            "type": "string"
          },
          "world_version": {
            "type": "string",
            "description": "Empty when the optional world source/table/version row is absent."
          },
          "public_host": {
            "type": "string"
          },
          "public_auth_port": {
            "type": "integer"
          },
          "public_world_port": {
            "type": "integer"
          },
          "population": {
            "$ref": "#/components/schemas/Population"
          }
        }
      },
      "Player": {
        "type": "object",
        "required": [
          "name",
          "level",
          "race",
          "race_id",
          "class",
          "class_id",
          "zone",
          "faction"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "race": {
            "type": "string"
          },
          "race_id": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "type": "string"
          },
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "zone": {
            "type": "string"
          },
          "faction": {
            "type": "string"
          }
        }
      },
      "BoardRow": {
        "type": "object",
        "required": [
          "rank",
          "name",
          "level",
          "class",
          "value",
          "raw"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "description": "Human-readable display value."
          },
          "raw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Numeric value in the units documented on the containing leaderboard."
          }
        }
      },
      "Leaderboards": {
        "type": "object",
        "required": [
          "playtime",
          "kills",
          "honor",
          "arena",
          "gold"
        ],
        "properties": {
          "playtime": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: seconds played."
          },
          "kills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: total kill count."
          },
          "honor": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: honor points."
          },
          "arena": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: arena points, not rating."
          },
          "gold": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: copper (10000 copper per gold)."
          }
        },
        "description": "Each board uses LEADERBOARD_SIZE (default 20, maximum 100), excludes bot accounts and Auctioneer, and honors HIDE_GM. Offline characters are included."
      },
      "Module": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "required": [
          "status",
          "players",
          "leaderboards",
          "modules"
        ],
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "players": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Player"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "leaderboards": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Leaderboards"
              },
              {
                "type": "null"
              }
            ]
          },
          "modules": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Module"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "Failed sections are null. Successful empty lists are []. Modules describe detected installations, not runtime health."
      },
      "DashboardResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "cache_ttl_seconds",
          "demo",
          "partial",
          "data",
          "errors"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Collection start timestamp in UTC, optionally with fractional seconds."
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "minimum": 5,
            "description": "Configured collection cache lifetime, default 20 seconds, measured after collection completes."
          },
          "demo": {
            "type": "boolean"
          },
          "partial": {
            "type": "boolean",
            "description": "True when dashboard sections are unavailable; always false for successful dedicated responses."
          },
          "data": {
            "$ref": "#/components/schemas/Dashboard"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionError"
            }
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "cache_ttl_seconds",
          "demo",
          "partial",
          "data",
          "errors"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Collection start timestamp in UTC, optionally with fractional seconds."
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "minimum": 5,
            "description": "Configured collection cache lifetime, default 20 seconds, measured after collection completes."
          },
          "demo": {
            "type": "boolean"
          },
          "partial": {
            "type": "boolean",
            "description": "True when dashboard sections are unavailable; always false for successful dedicated responses."
          },
          "data": {
            "$ref": "#/components/schemas/Status"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionError"
            }
          }
        }
      },
      "PlayersResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "cache_ttl_seconds",
          "demo",
          "partial",
          "data",
          "errors"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Collection start timestamp in UTC, optionally with fractional seconds."
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "minimum": 5,
            "description": "Configured collection cache lifetime, default 20 seconds, measured after collection completes."
          },
          "demo": {
            "type": "boolean"
          },
          "partial": {
            "type": "boolean",
            "description": "True when dashboard sections are unavailable; always false for successful dedicated responses."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionError"
            }
          }
        }
      },
      "LeaderboardsResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "cache_ttl_seconds",
          "demo",
          "partial",
          "data",
          "errors"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Collection start timestamp in UTC, optionally with fractional seconds."
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "minimum": 5,
            "description": "Configured collection cache lifetime, default 20 seconds, measured after collection completes."
          },
          "demo": {
            "type": "boolean"
          },
          "partial": {
            "type": "boolean",
            "description": "True when dashboard sections are unavailable; always false for successful dedicated responses."
          },
          "data": {
            "$ref": "#/components/schemas/Leaderboards"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionError"
            }
          }
        }
      },
      "ModulesResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "cache_ttl_seconds",
          "demo",
          "partial",
          "data",
          "errors"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Collection start timestamp in UTC, optionally with fractional seconds."
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "minimum": 5,
            "description": "Configured collection cache lifetime, default 20 seconds, measured after collection completes."
          },
          "demo": {
            "type": "boolean"
          },
          "partial": {
            "type": "boolean",
            "description": "True when dashboard sections are unavailable; always false for successful dedicated responses."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Module"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionError"
            }
          }
        }
      }
    },
    "responses": {
      "Dashboard": {
        "description": "Cached dashboard; check partial and errors, even when every section is unavailable.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DashboardResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token. Authentication precedes method and route checks.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          },
          "WWW-Authenticate": {
            "schema": {
              "type": "string",
              "const": "Bearer realm=\"management\""
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "API disabled or endpoint not found.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Only GET and HEAD are supported.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          },
          "Allow": {
            "schema": {
              "type": "string",
              "const": "GET, HEAD"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected request failure.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "DashboardHeaders": {
        "description": "Cached dashboard; check partial and errors, even when every section is unavailable.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          }
        }
      },
      "UnauthorizedHeaders": {
        "description": "Missing or invalid bearer token. Authentication precedes method and route checks.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          },
          "WWW-Authenticate": {
            "schema": {
              "type": "string",
              "const": "Bearer realm=\"management\""
            }
          }
        }
      },
      "NotFoundHeaders": {
        "description": "API disabled or endpoint not found.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "Content-Length": {
            "$ref": "#/components/headers/ContentLength"
          }
        }
      },
      "MethodNotAllowedHeaders": {
        "description": "Only GET and HEAD are supported.",
