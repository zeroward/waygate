{
  "openapi": "3.1.0",
  "info": {
    "title": "Gatehouse read-only management API",
    "version": "1.0.0",
    "description": "Backend bearer-token integration. Disabled when MANAGEMENT_API_TOKEN is empty. Poll /api/v1/dashboard every 20 seconds by default. GET and HEAD only; no pagination or filters, query parameters are ignored. Paths are exact (no trailing slash). Browser sessions and CORS are not used. Collection errors are cached for the configured TTL and reported explicitly."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "managementBearer": []
    }
  ],
  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Fetch all realm dashboard data in one snapshot",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Dashboard"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "operationId": "headDashboard",
        "summary": "Headers for dashboard",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DashboardHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Fetch realm reachability and population counts",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Status"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headStatus",
        "summary": "Headers for status",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/StatusHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/players": {
      "get": {
        "operationId": "getPlayers",
        "summary": "List online human characters, including GMs",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Players"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headPlayers",
        "summary": "Headers for players",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/PlayersHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/leaderboards": {
      "get": {
        "operationId": "getLeaderboards",
        "summary": "Fetch all five leaderboards",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Leaderboards"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headLeaderboards",
        "summary": "Headers for leaderboards",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/LeaderboardsHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/modules": {
      "get": {
        "operationId": "getModules",
        "summary": "List detected module IDs and titles",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Modules"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "operationId": "headModules",
        "summary": "Headers for modules",
        "description": "Same status and headers as GET, without a response body.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ModulesHeaders"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedHeaders"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundHeaders"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowedHeaders"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorHeaders"
          },
          "503": {
            "$ref": "#/components/responses/UnavailableHeaders"
          }
        }
      }
    },
    "/api/v1/admin/accounts": {
      "get": {
        "operationId": "adminListAccounts",
        "security": [{ "adminBearer": [] }],
        "summary": "List and search accounts with Gatehouse identity links",
        "responses": {
          "200": { "$ref": "#/components/responses/AdminData" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "adminCreateAccount",
        "security": [{ "adminBearer": [] }],
        "summary": "Create a Gatehouse and WoW account",
        "responses": {
          "201": { "$ref": "#/components/responses/AdminData" },
          "400": { "$ref": "#/components/responses/Unauthorized" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/admin/accounts/{username}": {
      "get": {
        "operationId": "adminGetAccount",
        "security": [{ "adminBearer": [] }],
        "summary": "Inspect account, Gatehouse identity, linked logins, and characters",
        "responses": {
          "200": { "$ref": "#/components/responses/AdminData" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/admin/accounts/{username}/password": {
      "post": {
        "operationId": "adminResetAccountPassword",
        "security": [{ "adminBearer": [] }],
        "summary": "Reset WoW and linked Gatehouse password and revoke active sessions",
        "responses": {
          "200": { "$ref": "#/components/responses/AdminData" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/admin/accounts/{username}/rank": {
      "put": {
        "operationId": "adminSetAccountRank",
        "security": [{ "adminBearer": [] }],
        "summary": "Set rank (0..3) across Gatehouse and linked WoW logins",
        "responses": {
          "200": { "$ref": "#/components/responses/AdminData" },
          "400": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/admin/accounts/{username}/ban": {
      "post": {
        "operationId": "adminBanAccount",
        "security": [{ "adminBearer": [] }],
        "summary": "Suspend account and linked WoW logins and revoke sessions",
        "responses": {
          "200": { "$ref": "#/components/responses/AdminData" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "operationId": "adminUnbanAccount",
        "security": [{ "adminBearer": [] }],
        "summary": "Lift suspension across linked WoW logins",
        "responses": {
          "200": { "$ref": "#/components/responses/AdminData" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/admin/banner": {
      "get": {
        "operationId": "adminGetBanner",
        "security": [{ "adminBearer": [] }],
        "summary": "Get maintenance banner state",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "put": {
        "operationId": "adminSetBanner",
        "security": [{ "adminBearer": [] }],
        "summary": "Set maintenance banner message and optional expiration",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "delete": {
        "operationId": "adminClearBanner",
        "security": [{ "adminBearer": [] }],
        "summary": "Clear maintenance banner",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/register-key": {
      "get": {
        "operationId": "adminGetRegisterKey",
        "security": [{ "adminBearer": [] }],
        "summary": "Get registration key state",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "put": {
        "operationId": "adminSetRegisterKey",
        "security": [{ "adminBearer": [] }],
        "summary": "Set or clear registration key",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "delete": {
        "operationId": "adminClearRegisterKey",
        "security": [{ "adminBearer": [] }],
        "summary": "Clear registration key (open public registration)",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/calendar": {
      "get": {
        "operationId": "adminListCalendar",
        "security": [{ "adminBearer": [] }],
        "summary": "List realm calendar events",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "post": {
        "operationId": "adminCreateCalendarEvent",
        "security": [{ "adminBearer": [] }],
        "summary": "Create realm calendar event",
        "responses": { "201": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/calendar/{id}": {
      "delete": {
        "operationId": "adminDeleteCalendarEvent",
        "security": [{ "adminBearer": [] }],
        "summary": "Delete realm calendar event by ID",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/audit": {
      "get": {
        "operationId": "adminListAuditEvents",
        "security": [{ "adminBearer": [] }],
        "summary": "List recent staff and API audit events",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/tickets": {
      "get": {
        "operationId": "adminListTickets",
        "security": [{ "adminBearer": [] }],
        "summary": "List support tickets filtered by status or account_id",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/tickets/{id}": {
      "get": {
        "operationId": "adminGetTicket",
        "security": [{ "adminBearer": [] }],
        "summary": "Get ticket and message thread",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "patch": {
        "operationId": "adminUpdateTicket",
        "security": [{ "adminBearer": [] }],
        "summary": "Update ticket status and/or post a staff reply",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/kb": {
      "get": {
        "operationId": "adminListKBArticles",
        "security": [{ "adminBearer": [] }],
        "summary": "List all Knowledge Base articles (including drafts) and categories",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "post": {
        "operationId": "adminCreateKBArticle",
        "security": [{ "adminBearer": [] }],
        "summary": "Create Knowledge Base article",
        "responses": { "201": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/kb/{id}": {
      "get": {
        "operationId": "adminGetKBArticle",
        "security": [{ "adminBearer": [] }],
        "summary": "Get Knowledge Base article by numeric ID or slug",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "put": {
        "operationId": "adminUpdateKBArticle",
        "security": [{ "adminBearer": [] }],
        "summary": "Update Knowledge Base article by numeric ID",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "delete": {
        "operationId": "adminDeleteKBArticle",
        "security": [{ "adminBearer": [] }],
        "summary": "Delete Knowledge Base article by numeric ID",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/downloads": {
      "get": {
        "operationId": "adminListDownloads",
        "security": [{ "adminBearer": [] }],
        "summary": "List downloads catalog and storage status",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      },
      "post": {
        "operationId": "adminUploadDownload",
        "security": [{ "adminBearer": [] }],
        "summary": "Upload downloadable archive via multipart/form-data",
        "responses": { "201": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/downloads/{id}": {
      "delete": {
        "operationId": "adminDeleteDownload",
        "security": [{ "adminBearer": [] }],
        "summary": "Remove download entry and file",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/game/unstuck": {
      "post": {
        "operationId": "adminUnstuckCharacter",
        "security": [{ "adminBearer": [] }],
        "summary": "Unstuck an offline character by GUID or name",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/game/announce": {
      "post": {
        "operationId": "adminGameAnnounce",
        "security": [{ "adminBearer": [] }],
        "summary": "Broadcast an in-game announcement via SOAP",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    },
    "/api/v1/admin/game/soap": {
      "post": {
        "operationId": "adminGameSOAP",
        "security": [{ "adminBearer": [] }],
        "summary": "Execute a non-credential worldserver SOAP command",
        "responses": { "200": { "$ref": "#/components/responses/AdminData" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "managementBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated MANAGEMENT_API_TOKEN, minimum 32 printable ASCII characters without spaces. Send in Authorization only. No cookies or query-string credentials."
      },
      "adminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated ADMIN_API_TOKEN, minimum 32 printable ASCII characters without spaces, distinct from MANAGEMENT_API_TOKEN."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "not_found",
              "method_not_allowed",
              "internal_error",
              "status_unavailable",
              "players_unavailable",
              "leaderboards_unavailable",
              "modules_unavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "CollectionError": {
        "type": "object",
        "required": [
          "section",
          "code",
          "message"
        ],
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "status",
              "players",
              "leaderboards",
              "modules"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "status_unavailable",
              "players_unavailable",
              "leaderboards_unavailable",
              "modules_unavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Population": {
        "type": "object",
        "required": [
          "humans",
          "bots",
          "gms",
          "total",
          "alliance",
          "horde"
        ],
        "properties": {
          "humans": {
            "type": "integer",
            "minimum": 0
          },
          "bots": {
            "type": "integer",
            "minimum": 0
          },
          "gms": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "alliance": {
            "type": "integer",
            "minimum": 0
          },
          "horde": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "Online character counts. Humans include GMs; gms is a subset. Total is humans plus bots. Faction counts cover humans. Aggregate counts do not apply the Auctioneer roster exclusion."
      },
      "Status": {
        "type": "object",
        "required": [
          "realm_name",
          "realm_up",
          "core_name",
          "expansion",
          "world_version",
          "public_host",
          "public_auth_port",
          "public_world_port",
          "population"
        ],
        "properties": {
          "realm_name": {
            "type": "string"
          },
          "realm_up": {
            "type": "boolean",
            "description": "Successful read-only SOAP server info probe or TCP worldserver connection. False is valid realm-down data, not a collection error."
          },
          "core_name": {
            "type": "string"
          },
          "expansion": {
            "type": "string"
          },
          "world_version": {
            "type": "string",
            "description": "Empty when the optional world source/table/version row is absent."
          },
          "public_host": {
            "type": "string"
          },
          "public_auth_port": {
            "type": "integer"
          },
          "public_world_port": {
            "type": "integer"
          },
          "population": {
            "$ref": "#/components/schemas/Population"
          }
        }
      },
      "Player": {
        "type": "object",
        "required": [
          "name",
          "level",
          "race",
          "race_id",
          "class",
          "class_id",
          "zone",
          "faction"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "race": {
            "type": "string"
          },
          "race_id": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "type": "string"
          },
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "zone": {
            "type": "string"
          },
          "faction": {
            "type": "string"
          }
        }
      },
      "BoardRow": {
        "type": "object",
        "required": [
          "rank",
          "name",
          "level",
          "class",
          "value",
          "raw"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "description": "Human-readable display value."
          },
          "raw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Numeric value in the units documented on the containing leaderboard."
          }
        }
      },
      "Leaderboards": {
        "type": "object",
        "required": [
          "playtime",
          "kills",
          "honor",
          "arena",
          "gold"
        ],
        "properties": {
          "playtime": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: seconds played."
          },
          "kills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: total kill count."
          },
          "honor": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: honor points."
          },
          "arena": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: arena points, not rating."
          },
          "gold": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoardRow"
            },
            "description": "Raw units: copper (10000 copper per gold)."
          }
        },
        "description": "Each board uses LEADERBOARD_SIZE (default 20, maximum 100), excludes bot accounts and Auctioneer, and honors HIDE_GM. Offline characters are included."
      },
      "Module": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "required": [
          "status",
          "players",
