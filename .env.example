# =============================================================================
# Gatehouse (waygate) — AzerothCore WotLK 3.3.5a realm portal
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# Docker Compose: attach to the AzerothCore network.
# `docker network ls | grep ac-network` — official AC compose uses
# `{directory}_ac-network`, e.g. azerothcore-wotlk_ac-network, not "ac-network".
AC_NETWORK=azerothcore-wotlk_ac-network
WEBREG_PORT=3080

# --- Process -----------------------------------------------------------------
LISTEN_ADDR=:3080
# When true, no MySQL/SOAP required. Fake realm status so the UI can be developed.
DEMO_MODE=true
LOG_LEVEL=info
# Trust X-Forwarded-For / X-Real-IP (only behind a known reverse proxy).
TRUST_PROXY=false
# Public site URL used in password-reset emails and passkeys (no trailing slash).
# Passkeys use this host as the WebAuthn RP ID. It must match the hostname in the browser.
SITE_URL=http://127.0.0.1:3080
# Optional WebAuthn overrides. Leave empty to use SITE_URL.
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGINS=
# Session cookie Secure flag. Set true when serving over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_TTL_HOURS=24

# --- Realm (public-facing) ---------------------------------------------------
CORE_NAME=AzerothCore WotLK 3.3.5a
REALM_NAME=Icecrown
# Hostname players put in realmlist.wtf
PUBLIC_HOST=127.0.0.1
PUBLIC_AUTH_PORT=3724
# This host publishes world as 28085, not the core default 8085.
PUBLIC_WORLD_PORT=28085
DEFAULT_EXPANSION=2
SITE_BLURB=Wrath of the Lich King 3.3.5a. The Frozen Throne waits above Icecrown. Real players only on the status boards — random playerbots are hidden.

# --- MySQL (same instance as ac-database; unused in DEMO_MODE) ---------------
MYSQL_HOST=ac-database
MYSQL_PORT=3306
MYSQL_USER=webreg
MYSQL_PASSWORD=change-me
AUTH_DB=acore_auth
CHARACTERS_DB=acore_characters
# Optional. Leave empty to skip world DB.
WORLD_DB=acore_world

# --- Internal probes (docker network names, not public ports) ----------------
WORLD_HOST=ac-worldserver
WORLD_PORT=8085
AUTH_HOST=ac-authserver
AUTH_PORT=3724

# --- SOAP (preferred account create / password change) -----------------------
# SOAP must listen on the docker network (SOAP.IP = 0.0.0.0 in worldserver.conf).
# Do not advertise SOAP credentials or bind SOAP to the public internet.
SOAP_ENABLED=true
SOAP_HOST=ac-worldserver
SOAP_PORT=7878
SOAP_USERNAME=
SOAP_PASSWORD=
SOAP_URI=urn:AC
SOAP_TIMEOUT_SECONDS=8
# auto = SOAP when enabled, SQL SRP6 fallback if SOAP is down.
# soap = SOAP only. sql = direct SRP6 insert/update only.
ACCOUNT_CREATE_MODE=auto

# --- Bots / GMs on public pages ---------------------------------------------
# Comma-separated username prefixes (case-insensitive). AzerothCore stores UPPERCASE.
BOT_USERNAME_PREFIXES=rndbot
# false: GM characters appear on leaderboards (this realm’s staff also play).
# true: omit account_access.gmlevel > 0 and extra_flags GM ON from boards.
HIDE_GM=false
# Minimum account_access.gmlevel to use the Admin panel (1=mod, 2=GM, 3=admin). Super GM is 4 and cannot be granted from the site.
GM_MIN_LEVEL=1
STATUS_CACHE_SECONDS=20
LEADERBOARD_SIZE=20

# --- Registration policy -----------------------------------------------------
REQUIRE_UNIQUE_EMAIL=true
PASSWORD_MIN_LENGTH=8
# Username 3–16 alphanumeric (fixed). Password max 16 (WoW 3.3.5a client limit).

# --- Captcha: none | turnstile | hcaptcha -----------------------------------
# Production should not use none. DEMO_MODE skips captcha even if configured.
CAPTCHA_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- SMTP (optional). If unset, contact is text-only and password reset is hidden.
# When set, new registrations stay inactive until the player opens the email link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
CONTACT_EMAIL=
DISCORD_URL=

# --- Rate limits (per IP, sliding window) ------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CONTACT=3
RATE_LIMIT_RESET=3
RATE_LIMIT_KB=20
RATE_LIMIT_UNSTUCK=5
RATE_LIMIT_TICKETS=5
WOW_CREDENTIALS_MAX=5

# --- Content -----------------------------------------------------------------
HOW_TO_CONNECT_FILE=content/how-to-connect.md
# SQLite knowledge base (not the WoW databases). Bind-mounted as ./data in Compose.
KB_PATH=data/kb.sqlite
# Client zip + patches/mods. Admins can upload from the Admin panel. See downloads/README.md.
DOWNLOADS_DIR=downloads
DOWNLOADS_CATALOG=downloads/catalog.json
# Max upload size for the Admin panel Downloads form (megabytes).
# 20 GiB so a ~17 GB client zip fits. Hard cap is 64 GiB.
DOWNLOADS_MAX_UPLOAD_MB=20480
# clamd TCP address. Empty disables scanning (tests/demo). Compose sets clamav:3310.
# Uploads fail closed if this is set and clamd is down.
CLAMAV_ADDR=
CLAMAV_TIMEOUT_SECONDS=600
# Skip ClamAV for files larger than this (client zips, big graphic patches).
CLAMAV_SCAN_MAX_MB=100
# Process uid/gid inside the container so it can write the downloads bind-mount.
# Match the host owner of ./downloads (typically 1000:1000).
WEBREG_UID=1000
WEBREG_GID=1000
# AzerothCore modules/ on the host. Compose bind-mounts this read-only.
AC_MODULES_DIR=/var/home/core/azerothcore/azerothcore-wotlk/modules
# Path inside the container (or on the host if you run the binary without Docker).
MODULES_DIR=/azerothcore/modules
